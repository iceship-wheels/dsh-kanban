{
  "name": "dsh-plugin-kanban",
  "version": "0.1.0",
  "description": "A project kanban board for the DSH sidebar: markdown tiles, dynamic heights, and a masonry layout that adapts to the window.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
